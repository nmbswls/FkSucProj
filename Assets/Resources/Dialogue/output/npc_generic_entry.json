{
  "Steps": [
    {
      "Id": "npc_hub",
      "Note": "入口：动态选项 + 可路由回此 Step",
      "Commands": [
        {
          "$type": "My.Dialog.DialogCommandData4DynamicNpcChoice, Assembly-CSharp",
          "TimeLimit": 0.0
        }
      ]
    },
    {
      "Id": "shop",
      "Note": "打开商店",
      "Commands": [
        {
          "$type": "My.Dialog.DialogCommandData4OpenShop, Assembly-CSharp",
          "BindingShop": true
        },
        {
          "$type": "My.Dialog.DialogCommandData4JumpTo, Assembly-CSharp",
          "TargetStepId": "npc_hub"
        }
      ]
    },
    {
      "Id": "hub_combat",
      "Note": "战斗中",
      "Commands": [
        {
          "$type": "My.Dialog.DialogCommandData4Text, Assembly-CSharp",
          "TextLines": [
            {
              "Speaker": "NPC",
              "Content": "……现在不是说这个的时候！",
              "VoiceLine": null
            }
          ],
          "Speaker": null,
          "Content": null,
          "VoiceLine": null
        },
        {
          "$type": "My.Dialog.DialogCommandData4SwitchDialogSegment, Assembly-CSharp",
          "TargetStepId": "npc_hub",
          "CancelTypingState": true
        }
      ]
    },
    {
      "Id": "hub_bye",
      "Note": "结束",
      "Commands": [
        {
          "$type": "My.Dialog.DialogCommandData4Text, Assembly-CSharp",
          "TextLines": [
            {
              "Speaker": "NPC",
              "Content": "回见。",
              "VoiceLine": null
            }
          ],
          "Speaker": null,
          "Content": null,
          "VoiceLine": null
        }
      ]
    }
  ]
}
