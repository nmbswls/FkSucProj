<module name="demo">

    <!-- 道具主表用枚举；EItemUseType 各类型参数见 item.xlsx 的 item_use 表头注释与 schema 末尾说明 -->
    <enum name="EItemType">
        <var name="Normal" value="0"/>
        <var name="Currency" value="1"/>
        <var name="Equip" value="2"/>
        <var name="Pocket" value="3"/>
        <var name="Insertion" value="4"/>
    </enum>

    <enum name="EItemStackType">
        <var name="NoStack" value="0"/>
        <var name="Size1" value="1"/>
        <var name="Size2" value="2"/>
        <var name="Size3" value="3"/>
        <var name="Size4" value="4"/>
        <var name="Custom" value="5"/>
        <var name="NoLimit" value="6"/>
    </enum>

    <enum name="EItemRevealEffectType">
        <var name="None" value="0"/>
        <var name="AddGcVal" value="1"/>
        <var name="CostClothes" value="2"/>
    </enum>

    <!-- AddHunger: p1=饥饿增量(逻辑内再乘系数); GiveDrop: p1=drop_bundle_id; UseAbility: s1=技能/能力名 -->
    <enum name="EItemUseType">
        <var name="None" value="0"/>
        <var name="AddHunger" value="1"/>
        <var name="GiveDrop" value="2"/>
        <var name="UseAbility" value="3"/>
    </enum>

    <enum name="ECommonCheckType">
		<var name="None" value="0"/>
        <var name="TaskFinish" value="1"/>
        <var name="CheckVariable" value="2"/>
        <var name="OwnItem" value="4"/>
		<var name="TaskStep" value="5"/>
		<var name="AlwaysFail" value="6"/>
    </enum>

    <!-- 2. 定义复杂结构 Bean (列表中的元素结构) -->
    <!-- 这个结构体代表"一个奖励" -->
    <bean name="CommonCheckCond" tags="sep=,">
        <var name="type" type="ECommonCheckType" comment="类型"/>
        <var name="param1" type="long" comment="p1"/>
        <var name="param2" type="long" comment="p2"/>
		<var name="param3" type="long" comment="p3"/>
		<var name="param4" type="long" comment="p4"/>
        <var name="param5" type="string" comment="p5"/>
        <var name="param6" type="string" comment="p6"/>
    </bean>

	<enum name="EWantedBehaveType">
        <var name="None" value="0"/>
		<var name="StealSmall" value="1"/>
		<var name="StealValuable" value="2"/>
		<var name="AssaultCitizen" value="3"/>
    </enum>

	<!-- 通缉守卫档位由 wanted.xlsx#wanted_guard_spawn 表头定义（TbWantedGuardSpawnTier），勿在此重复定义同名 bean -->
    <!-- DreamInfiltrationSpot、FishingSpot、FishingSpotFish 均在 xlsx 表头定义（read_schema_from_file）；鱼种行通过 spot_id 关联钓点 id -->

    <!-- 天赋树：主表 talent.xlsx 用 read_schema_from_file；嵌套类型在此定义 -->
    <bean name="TalentUnlockCost" tags="sep=,">
        <var name="item_id" type="string" comment="道具 id"/>
        <var name="count" type="long" comment="数量"/>
    </bean>

    <bean name="TalentStatBonus" tags="sep=,">
        <var name="attr_id" type="int" comment="EYCAttribute 枚举整型"/>
        <var name="val" type="long" comment="固定加成"/>
    </bean>

    <!-- 战斗技能（原 SkillLibrary 硬编码，与 Config.Unit.EntitySkillCfg 字段对应） -->
    <enum name="ESkillCastConditionType">
        <var name="None" value="0"/>
        <var name="HMode" value="1"/>
        <var name="QueenMode" value="2"/>
        <var name="NoQueenMode" value="3"/>
    </enum>

    <bean name="SkillAbilityExtraPair" tags="sep=,">
        <var name="key" type="string"/>
        <var name="val" type="string"/>
    </bean>

    <bean name="SkillCastCondition" tags="sep=,">
        <var name="type" type="ESkillCastConditionType"/>
        <var name="param1" type="long"/>
        <var name="param2" type="long"/>
        <var name="param3" type="string"/>
        <var name="param4" type="string"/>
    </bean>

    <!-- 欲望结晶：TbDesireCrystalDef / TbMapDesireCrystalBudget / TbMapWalkerDesireCrystalQuota / TbNamedNpcDesireCrystal 在 Config/Datas/desire_crystal.xlsx；TbUnitNpc 字段 desire_crystal_random_attachable 在 unit_npc.xlsx；生成脚本 gen_desire_crystal_tables.py -->

    <!-- 影怪：player_desire_level 含后场数量/半径/drift（ambient_spirit_prefab 已由代码废弃，后场外观走 spirit_monster_budget + TbUnitNpc.prefab_name → Resources/SpiritMonsterAmbient）；实战预算与同文件 spirit_monster_budget；__tables__ 挂载见 gen_spirit_monster_budget_tables.py -->

</module>