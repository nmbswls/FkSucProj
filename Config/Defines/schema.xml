        <var name="Custom" value="0"/>
        <var name="Single" value="1"/>
        <var name="Tiny" value="2"/>
        <var name="Small" value="3"/>
        <var name="Normal" value="4"/>
        <var name="Bulk" value="5"/>
        <var name="Large" value="6"/>
        <var name="Massive" value="7"/>
        <var name="Unlimited" value="8"/>
    </enum>

    <enum name="EGiftTag">
        <var name="None" value="0"/>
        <var name="Food" value="1"/>
        <var name="Luxury" value="2"/>
        <var name="Quest" value="3"/>
        <var name="Daily" value="4"/>
    </enum>

    <enum name="EJingYuanType">
        <var name="None" value="0"/>
        <var name="OrcI" value="1"/>
        <var name="OrcII" value="2"/>
        <var name="HumanI" value="3"/>
        <var name="HumanII" value="4"/>
        <var name="HumanIII" value="5"/>
        <var name="HumanIV" value="6"/>
        <var name="HumanV" value="7"/>
        <var name="HumanVI" value="8"/>
        <var name="HumanVII" value="9"/>
        <var name="MonsterI" value="10"/>
        <var name="MonsterII" value="11"/>
        <var name="MonsterIII" value="12"/>
    </enum>

    <!-- 与 My.EContainerType 数值必须一致 -->
    <enum name="EContainerType">
        <var name="Inventory" value="0"/>
        <var name="LootPoint" value="1"/>
        <var name="SpecialInventory" value="2"/>
        <var name="Shop" value="3"/>
        <var name="Warehouse" value="4"/>
    </enum>

    <enum name="EItemRevealEffectType">
        <var name="None" value="0"/>
        <var name="AddGcVal" value="1"/>
        <var name="CostClothes" value="2"/>
    </enum>

    <!-- 市集结算读取的建筑属性；每级按百分比档位解释。 -->
    <enum name="EBuildingAttribute">
        <var name="None" value="0"/>
        <var name="GoldOutputBonus" value="1"/>
        <var name="OutputEfficiency" value="2"/>
        <var name="MarketSaleChanceBonus" value="3"/>
        <var name="MarketPriceBonus" value="4"/>
        <var name="MarketSlotCount" value="5"/>
        <var name="TransportMinPickupCount" value="6"/>
        <var name="TransportMaxPickupCount" value="7"/>
    </enum>

    <!-- AddHunger: p1=饥饿增量(逻辑内再乘系数); GiveDrop: p1=drop_bundle_id; UseSkill: s1=技能/能力名; UnlockRuneUpgrade: s1=upgrade_id; AddMapControl: p1=控制度增量; s1=logic_area map_id; AddJingYuanCodexProgress: s1=codex_id; p1=榨取次数; p2=amount(x1000); AddJingYuanCodexBlurtDrop: s1=codex_id; p1=榨取次数; cnt=amount(x1000) -->
    <enum name="EItemUseType">
        <var name="None" value="0"/>
        <var name="AddHunger" value="1"/>
        <var name="GiveDrop" value="2"/>
        <var name="UseSkill" value="3"/>
        <var name="UnlockRuneUpgrade" value="4"/>
        <var name="AddMapControl" value="5"/>
        <var name="AddJingYuanCodexProgress" value="6"/>
        <var name="AddJingYuanCodexBlurtDrop" value="7"/>
        <var name="AddPremiumEssence" value="8"/>
    </enum>

    <enum name="EItemUseConsumePolicy">
        <var name="None" value="0"/>
        <var name="StackCount" value="1"/>
        <var name="InstanceCharge" value="2"/>
        <var name="DestroyInstance" value="3"/>
    </enum>

    <enum name="EHumanWeaponFuncType">
        <var name="Melee" value="0"/>
        <var name="Ranged" value="1"/>
    </enum>

    <enum name="EFacilityEffectType">
        <var name="None" value="0"/>
        <var name="AddBuildingAttribute" value="1"/>
        <var name="AddHumanCivilizationAttribute" value="2"/>
    </enum>

    <enum name="ECommonCheckType">
		<var name="None" value="0"/>
        <var name="TaskFinish" value="1"/>
        <var name="CheckVariable" value="2"/>
        <var name="OwnItem" value="4"/>
		<var name="TaskStep" value="5"/>
		<var name="AlwaysFail" value="6"/>
		<var name="FuncOpen" value="7"/>
		<var name="CharacterFavorLevel" value="8"/>
		<var name="HumanTechUnlockedCount" value="9"/>
		<var name="ControlledTownCount" value="10"/>
		<var name="NamedNpcLocalSwitch" value="11"/>
    </enum>

    <enum name="ESecretBaseCharacterOptionAction">
		<var name="Talk" value="0"/>
		<var name="Gift" value="1"/>
		<var name="OpenTalentTree" value="2"/>
		<var name="OpenPanel" value="3"/>
		<var name="OpenOptionGroup" value="4"/>
        <var name="GivePremiumEssence" value="5"/>
        <var name="AppraiseHumanArmar" value="6"/>
    </enum>

    <!-- Statistic / EventGrant：共性计数与通用授予 -->
    <enum name="EStatType">
        <var name="None" value="0"/>
        <var name="KillNpcCfg" value="1"/>
        <var name="EnterOverlay" value="2"/>
        <var name="QuestComplete" value="3"/>
        <var name="UseItem" value="4"/>
        <var name="InteractUniq" value="5"/>
        <var name="ExtractCodex" value="6"/>
        <var name="PlayerDeath" value="7"/>
        <var name="BlurtAbsorb" value="8"/>
        <var name="UnsensoredRace" value="9"/>
    </enum>

    <enum name="EStatCompareOp">
        <var name="Gte" value="0"/>
        <var name="Eq" value="1"/>
    </enum>

    <enum name="EEventGrantDeliverMode">
        <var name="GrantItemsOnce" value="0"/>
        <var name="AssemblePassive" value="1"/>
    </enum>

    <enum name="EEventGrantCategory">
        <var name="None" value="0"/>
        <var name="Knowledge" value="1"/>
        <var name="Achievement" value="2"/>
    </enum>

    <bean name="EventGrantTarget" tags="sep=,">
        <var name="stat_type" type="EStatType" comment="统计类型"/>
        <var name="arg0" type="string" comment="参数0"/>
        <var name="arg1" type="string" comment="参数1"/>
        <var name="op" type="EStatCompareOp" comment="比较"/>
        <var name="value" type="long" comment="阈值"/>
    </bean>

    <!-- 2. 定义复杂结构 Bean (列表中的元素结构) -->
    <!-- 这个结构体代表"一个奖励" -->
    <enum name="EQuestDialogShowCondType">
        <var name="None" value="0"/>
        <var name="ObjectiveDialogTriggered" value="1"/>
        <var name="ObjectiveDialogNotTriggered" value="2"/>
    </enum>

    <bean name="QuestDialogShowCond" tags="sep=,">
        <var name="type" type="EQuestDialogShowCondType" comment="任务对话显示条件"/>
        <var name="dialog_id" type="int" comment="QuestObjectiveDialog.id"/>
    </bean>

    <bean name="CommonCheckCond" tags="sep=,">
        <var name="type" type="ECommonCheckType" comment="类型"/>
        <var name="param1" type="long" comment="p1"/>
        <var name="param2" type="long" comment="p2"/>
		<var name="param3" type="long" comment="p3"/>
		<var name="param4" type="long" comment="p4"/>
        <var name="param5" type="string" comment="p5"/>
        <var name="param6" type="string" comment="p6"/>
    </bean>

    <bean name="HumanCivilizationCustomCond" tags="sep=,">
        <var name="type" type="string" comment="custom condition type"/>
        <var name="param1" type="string" comment="custom parameter"/>
        <var name="param2" type="long" comment="custom value"/>
    </bean>

	<enum name="EWantedBehaveType">
        <var name="None" value="0"/>
		<var name="StealSmall" value="1"/>
		<var name="StealValuable" value="2"/>
		<var name="AssaultCitizen" value="3"/>
		<var name="ForceExtractAssault" value="4"/>
    </enum>

	<!-- 通缉守卫档位由 wanted.xlsx#wanted_guard_spawn 表头定义（TbWantedGuardSpawnTier），勿在此重复定义同名 bean -->
    <!-- DreamInfiltrationSpot、FishingSpot、FishingSpotFish 均在 xlsx 表头定义（read_schema_from_file）；鱼种行通过 spot_id 关联钓点 id -->

    <!-- 天赋树：主表 talent.xlsx 用 read_schema_from_file；嵌套类型在此定义 -->
    <bean name="TalentUnlockCost" tags="sep=,">
        <var name="item_id" type="string" comment="道具 id"/>
        <var name="count" type="long" comment="数量"/>
    </bean>

    <bean name="TalentStatBonus" tags="sep=,">
        <var name="attr_id" type="int" comment="EYCAttribute 枚举整型"/>
        <var name="human_attr_id" type="EHumanCivilizationAttribute" comment="人类文明属性；无文明属性时填 None"/>
        <var name="val" type="long" comment="固定加成"/>
    </bean>

    <!-- 魅魔身体部位：Datas/body_part.xlsx -->
    <!-- 部位装备细节：Datas/partgear.xlsx → TbPartGear，item_id 关联 ItemData -->
    <enum name="EBodyPart">
        <var name="None" value="0"/>
        <var name="Mouth" value="1"/>
        <var name="Breast" value="2"/>
        <var name="Womb" value="3"/>
        <var name="Tail" value="4"/>
        <var name="Wing" value="5"/>
        <var name="Skin" value="6"/>
    </enum>

    <enum name="EPartLocalAttribute">
        <var name="None" value="0"/>
