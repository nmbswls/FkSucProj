        <var name="FluidGain" value="3"/>
        <var name="ControlResist" value="4"/>
        <var name="AuraLeak" value="5"/>
    </enum>

    <bean name="PartLocalStatBonus" tags="sep=,">
        <var name="attr_id" type="int" comment="EPartLocalAttribute 整型"/>
        <var name="val" type="long" comment="固定加成"/>
    </bean>

    <!-- 战斗技能（原 SkillLibrary 硬编码，与 Config.Unit.EntitySkillCfg 字段对应） -->
