		<var name="InBattle" value="5"/>
		<var name="UnarmedFallbackOnly" value="6"/>
    </enum>

    <bean name="SkillAbilityExtraPair" tags="sep=,">
        <var name="key" type="string"/>
        <var name="val" type="string"/>
    </bean>

    <bean name="SkillCastCondition" tags="sep=,">
        <var name="type" type="ESkillCastConditionType"/>
        <var name="param1" type="long"/>
        <var name="param2" type="long"/>
        <var name="param3" type="string"/>
        <var name="param4" type="string"/>
    </bean>

    <!-- 欲望结晶：TbDesireCrystalDef / TbMapDesireCrystalBudget / TbMapWalkerDesireCrystalQuota / TbNamedNpcDesireCrystal 在 Config/Datas/desire_crystal.xlsx；TbUnitNpc 字段 desire_crystal_random_attachable 在 unit_npc.xlsx；生成脚本 gen_desire_crystal_tables.py -->

    <!-- 影怪：player_desire_level 含 drift、Aura 等；后场徘徊环半径与假影怪数量由 AmbientSpiritVisualManager 按等级/理智推导；ambient_spirit_prefab 已废弃；外观 spirit_monster_budget + TbUnitNpc → Resources/SpiritMonsterAmbient；__tables__ 见 gen_spirit_monster_budget_tables.py -->

    <!-- 区域效果：与 FightStruct.EShapeType / ECampFilterType 数值对齐 -->
