<module name="demo">

    <!-- 道具主表用枚举；可堆叠用 stackable + stack_count（0 表示走默认基数 10；货币等大堆叠填 stack_count=999999）；堆叠 tag 见 stack_tags；容器规则见 container_stack.xlsx -->
    <!-- EItemUseType 各类型参数见 item.xlsx 的 item_use 表头注释与 schema 末尾说明 -->
    <enum name="EItemType">
        <var name="Normal" value="0"/>
        <var name="Currency" value="1"/>
        <var name="Equip" value="2"/>
        <var name="Pocket" value="3"/>
        <var name="Insertion" value="4"/>
    </enum>

    <!-- 与 My.EContainerType 数值必须一致 -->
    <enum name="EContainerType">
        <var name="Inventory" value="0"/>
        <var name="LootPoint" value="1"/>
        <var name="SpecialInventory" value="2"/>
        <var name="Shop" value="3"/>
        <var name="Warehouse" value="4"/>
    </enum>

    <enum name="EItemRevealEffectType">
        <var name="None" value="0"/>
        <var name="AddGcVal" value="1"/>
        <var name="CostClothes" value="2"/>
    </enum>

    <!-- AddHunger: p1=饥饿增量(逻辑内再乘系数); GiveDrop: p1=drop_bundle_id; UseAbility: s1=技能/能力名 -->
    <enum name="EItemUseType">
        <var name="None" value="0"/>
        <var name="AddHunger" value="1"/>
        <var name="GiveDrop" value="2"/>
        <var name="UseSkill" value="3"/>
    </enum>

    <enum name="EQuickBarItemKind">
        <var name="None" value="0"/>
        <var name="Weapon" value="1"/>
        <var name="Consumable" value="2"/>
    </enum>

    <enum name="ECommonCheckType">
		<var name="None" value="0"/>
        <var name="TaskFinish" value="1"/>
        <var name="CheckVariable" value="2"/>
        <var name="OwnItem" value="4"/>
		<var name="TaskStep" value="5"/>
		<var name="AlwaysFail" value="6"/>
    </enum>

    <!-- 2. 定义复杂结构 Bean (列表中的元素结构) -->
    <!-- 这个结构体代表"一个奖励" -->
    <bean name="CommonCheckCond" tags="sep=,">
        <var name="type" type="ECommonCheckType" comment="类型"/>
        <var name="param1" type="long" comment="p1"/>
        <var name="param2" type="long" comment="p2"/>
		<var name="param3" type="long" comment="p3"/>
		<var name="param4" type="long" comment="p4"/>
        <var name="param5" type="string" comment="p5"/>
        <var name="param6" type="string" comment="p6"/>
    </bean>

	<enum name="EWantedBehaveType">
        <var name="None" value="0"/>
		<var name="StealSmall" value="1"/>
		<var name="StealValuable" value="2"/>
		<var name="AssaultCitizen" value="3"/>
		<var name="ForceExtractAssault" value="4"/>
    </enum>

	<!-- 通缉守卫档位由 wanted.xlsx#wanted_guard_spawn 表头定义（TbWantedGuardSpawnTier），勿在此重复定义同名 bean -->
    <!-- DreamInfiltrationSpot、FishingSpot、FishingSpotFish 均在 xlsx 表头定义（read_schema_from_file）；鱼种行通过 spot_id 关联钓点 id -->

    <!-- 天赋树：主表 talent.xlsx 用 read_schema_from_file；嵌套类型在此定义 -->
    <bean name="TalentUnlockCost" tags="sep=,">
        <var name="item_id" type="string" comment="道具 id"/>
        <var name="count" type="long" comment="数量"/>
    </bean>

    <bean name="TalentStatBonus" tags="sep=,">
        <var name="attr_id" type="int" comment="EYCAttribute 枚举整型"/>
        <var name="val" type="long" comment="固定加成"/>
    </bean>

    <!-- 战斗技能（原 SkillLibrary 硬编码，与 Config.Unit.EntitySkillCfg 字段对应） -->
    <enum name="ESkillCastConditionType">
        <var name="None" value="0"/>
        <var name="HMode" value="1"/>
        <var name="QueenMode" value="2"/>
        <var name="NoQueenMode" value="3"/>
    </enum>

    <bean name="SkillAbilityExtraPair" tags="sep=,">
        <var name="key" type="string"/>
        <var name="val" type="string"/>
    </bean>

    <bean name="SkillCastCondition" tags="sep=,">
        <var name="type" type="ESkillCastConditionType"/>
        <var name="param1" type="long"/>
        <var name="param2" type="long"/>
        <var name="param3" type="string"/>
        <var name="param4" type="string"/>
    </bean>

    <!-- 欲望结晶：TbDesireCrystalDef / TbMapDesireCrystalBudget / TbMapWalkerDesireCrystalQuota / TbNamedNpcDesireCrystal 在 Config/Datas/desire_crystal.xlsx；TbUnitNpc 字段 desire_crystal_random_attachable 在 unit_npc.xlsx；生成脚本 gen_desire_crystal_tables.py -->

    <!-- 影怪：player_desire_level 含 drift、Aura 等；后场徘徊环半径与假影怪数量由 AmbientSpiritVisualManager 按等级/理智推导；ambient_spirit_prefab 已废弃；外观 spirit_monster_budget + TbUnitNpc → Resources/SpiritMonsterAmbient；__tables__ 见 gen_spirit_monster_budget_tables.py -->

    <!-- 区域效果：与 FightStruct.EShapeType / ECampFilterType 数值对齐 -->
    <enum name="EAreaShapeType">
        <var name="None" value="0"/>
        <var name="Square" value="1"/>
        <var name="Circle" value="2"/>
        <var name="Sector" value="3"/>
    </enum>

    <enum name="EAreaCampFilter">
        <var name="All" value="0"/>
        <var name="NotSelf" value="1"/>
        <var name="OnlySelf" value="2"/>
    </enum>

    <!-- MapAreaEffect 记录结构由 map_area_effect.xlsx 表头 read_schema_from_file 推断 -->

    <enum name="ERumorIntelKind">
        <var name="Fixed" value="0"/>
        <var name="RandomPoolEntry" value="1"/>
    </enum>

    <enum name="ERumorEffectType">
        <var name="Chest" value="0"/>
        <var name="Npc" value="1"/>
    </enum>

    <!-- TbUnitNpc 可选列 vision_cone_kind / vision_range / vision_fov_deg；与 My.Map.VisionConeKind 数值一致 -->
    <enum name="EVisionConeKind">
        <var name="Normal" value="0"/>
        <var name="Alert" value="1"/>
        <var name="Omniscient" value="2"/>
    </enum>

    <!-- 地图小剧情触发器与演出：Datas/micro_plot.xlsx，表见 __tables__ -->
    <enum name="EMicroPlotConsumeOn">
        <var name="SuccessOrAbort" value="0"/>
        <var name="SuccessOnly" value="1"/>
    </enum>

    <enum name="EMicroPlotEventKind">
        <var name="None" value="0"/>
        <var name="Log" value="1"/>
        <var name="NpcSpeak" value="2"/>
    </enum>

    <!-- 陷阱：Datas/trap_spec.xlsx，表见 __tables__ -->
    <bean name="TrapTriggerEffect" tags="sep=,">
        <var name="kind" type="int"/>
        <var name="buff_id" type="string"/>
        <var name="layer" type="int"/>
        <var name="duration" type="float"/>
        <var name="target_type" type="int"/>
    </bean>

    <!-- 锻造配方：Datas/forge_recipe.xlsx，表见 __tables__；unlock_param 任务填任务 id，HasItem 填道具 id 或 itemId|数量 -->
    <enum name="EForgeRecipeType">
        <var name="Weapon" value="0"/>
        <var name="Armor" value="1"/>
        <var name="Misc" value="2"/>
    </enum>

    <enum name="EForgeUnlockMode">
        <var name="None" value="0"/>
        <var name="QuestFinished" value="1"/>
        <var name="HasItem" value="2"/>
        <var name="GlobalSwitch" value="3"/>
    </enum>

    <bean name="ForgeMaterialCost" tags="sep=,">
        <var name="item_id" type="string" comment="材料道具 id"/>
        <var name="count" type="long" comment="数量"/>
    </bean>
</module>