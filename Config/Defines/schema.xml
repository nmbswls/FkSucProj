<module name="demo">

    <!-- ?????? Custom ?? stack_profile ?????Custom ?? stack_count?tags ????Perk ???????? -->
    <!-- EItemUseType 各类型参数见 item.xlsx 的 item_use 表头注释与 schema 末尾说明 -->
    <enum name="EItemType">
        <var name="Normal" value="0"/>
        <var name="Currency" value="1"/>
		<var name="MindFacet" value="10"/> 
    </enum>

    <!-- 礼物 tag：item_gift.gift_tags 多选；好感/赠礼匹配用 -->
